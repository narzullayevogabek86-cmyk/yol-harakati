{
  "name": "yol-harakati",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.14.1 <25"
  },
  "scripts": {
    "check:node": "node scripts/check-node-version.js",
    "preinstall": "node scripts/check-node-version.js",
    "predev": "node scripts/check-node-version.js",
    "prebuild:protected": "node scripts/check-node-version.js",
    "prebuild": "node scripts/check-node-version.js",
    "prebuild:native": "node scripts/check-node-version.js",
    "preandroid:sync": "node scripts/check-node-version.js",
    "preandroid:open": "node scripts/check-node-version.js",
    "preandroid:run": "node scripts/check-node-version.js",
    "build:protected": "node build-protected-content.js && node build-signs-static.js",
    "dev": "vite",
    "build": "npm run build:protected && vite build && node build-netlify-dist.js",
    "build:native": "npm run build:protected && YHQ_BUILD_TARGET=native vite build && YHQ_BUILD_TARGET=native node build-netlify-dist.js",
    "build:dist": "npm run build",
    "build:dist:native": "npm run build:native",
    "build:netlify": "npm run build:dist",
    "android:sync": "npm run build:dist:native && npx cap sync android",
    "android:open": "npx cap open android",
    "android:run": "npm run android:sync && npx cap run android",
    "postinstall": "node patch-capacitor-android.js",
    "prestart": "npm run build",
    "start": "PORT=3001 node server.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.2.0",
    "@capacitor/app": "^8.0.1",
    "@capacitor/core": "^8.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "clean-css": "^5.3.3",
    "express": "^4.21.2",
    "javascript-obfuscator": "^4.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@ljharb/tsconfig": "^0.3.2",
    "vite": "^7.0.0"
  }
}

{
  "name": "yol-harakati",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:protected": "node build-protected-content.js && node build-signs-static.js",
    "build": "npm run build:protected && node build-assets.js",
    "build:native": "npm run build:protected && YHQ_BUILD_TARGET=native node build-assets.js",
    "build:dist": "npm run build && node build-netlify-dist.js",
    "build:dist:native": "npm run build:native && YHQ_BUILD_TARGET=native node build-netlify-dist.js",
    "build:netlify": "npm run build:dist",
    "android:sync": "npm run build:dist:native && npx cap sync android",
    "android:open": "npx cap open android",
    "android:run": "npm run android:sync && npx cap run android",
    "postinstall": "node patch-capacitor-android.js",
    "prestart": "npm run build",
    "start": "PORT=3001 node server.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.2.0",
    "@capacitor/app": "^8.0.1",
    "@capacitor/core": "^8.2.0",
    "clean-css": "^5.3.3",
    "express": "^4.21.2",
    "javascript-obfuscator": "^4.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.2.0",
    "@ljharb/tsconfig": "^0.3.2"
  }
}
